<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller">
   <center>
      <TextField fx:id="playerEntryField" maxWidth="200.0" onKeyPressed="#jumpToNextField" promptText="Player entry field" BorderPane.alignment="CENTER" />
   </center>
   <top>
      <VBox alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="changeNetworkButton" contentDisplay="CENTER" mnemonicParsing="false" onAction="#networkButtonPressed" text="Change Network" />
            <TextField fx:id="networkField" maxWidth="200.0" onKeyPressed="#networkFieldKeyPress" promptText="Enter IP" />
         </children>
      </VBox>
   </top>
</BorderPane>
