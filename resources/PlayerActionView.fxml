<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PlayerActionController">
   <children>
      <VBox layoutX="250.0" layoutY="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER">
               <children>
                  <Label focusTraversable="false" text="Current Player Action" />
               </children>
            </HBox>
            <HBox alignment="CENTER">
               <children>
                  <Label alignment="CENTER" focusTraversable="false" maxWidth="1.7976931348623157E308" prefWidth="300.0" text="GREEN TEAM" HBox.hgrow="ALWAYS" />
                  <Label alignment="CENTER" focusTraversable="false" layoutX="10.0" layoutY="10.0" maxWidth="1.7976931348623157E308" prefWidth="300.0" text="RED TEAM" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="greenTeamTableView" focusTraversable="false" HBox.hgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="greenTeamMemeberCol" editable="false" prefWidth="75.0" sortable="false" text="Memeber" />
                      <TableColumn fx:id="greenTeamMemberScore" editable="false" prefWidth="75.0" sortable="false" text="Score" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <TableView fx:id="redTeamTableView" focusTraversable="false" HBox.hgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="redTeamMemberCol" editable="false" prefWidth="75.0" sortable="false" text="Memeber" />
                      <TableColumn fx:id="redTeamMemberScore" editable="false" prefWidth="75.0" sortable="false" text="Score" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </HBox>
            <GridPane gridLinesVisible="true" VBox.vgrow="NEVER">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                  <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                  <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints />
                  <RowConstraints />
                  <RowConstraints vgrow="NEVER" />
              </rowConstraints>
               <children>
                  <Label fx:id="greenTeamScore" alignment="CENTER_RIGHT" focusTraversable="false" text="Green Team Score" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.vgrow="NEVER" />
                  <Label fx:id="redTeamScore" alignment="CENTER_RIGHT" focusTraversable="false" text="Red Team Score" GridPane.columnIndex="3" GridPane.rowIndex="2" GridPane.vgrow="NEVER" />
               </children>
            </GridPane>
            <ListView fx:id="gameActionsListView" focusTraversable="false" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </children>
</AnchorPane>
